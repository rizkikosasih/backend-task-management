{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "rizkikosasih/backend-task-management",
  "type": "project",
  "description": "Backend Task Management RESTful API built with Laravel 12.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "dedoc/scramble": "^0.13.52",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.3",
    "laravel/socialite": "^5.28",
    "laravel/tinker": "^2.10.1",
    "spatie/laravel-permission": "^7.3"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.13",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "@php artisan serve"
    ],
    "lint": "vendor/bin/pint --test",
    "lint:fix": "vendor/bin/pint",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "setup": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --force --ansi",
      "@php artisan storage:link --ansi",
      "@php artisan optimize --ansi"
    ],
    "setup:local": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate:fresh --seed --ansi",
      "@php artisan storage:link --ansi",
      "@php artisan optimize:clear --ansi"
    ],
    "deploy": [
      "@php artisan down",
      "Composer\\Config::disableProcessTimeout",
      "@composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction",
      "@php artisan migrate --force --ansi",
      "@php artisan optimize:clear --ansi",
      "@php artisan optimize --ansi",
      "@php artisan queue:restart --ansi",
      "@php artisan up"
    ],
    "deploy:local": [
      "Composer\\Config::disableProcessTimeout",
      "@composer install --prefer-dist --no-interaction",
      "@php artisan migrate --ansi",
      "@php artisan optimize:clear --ansi"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "12.x-dev"
    },
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
